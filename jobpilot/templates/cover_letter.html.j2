<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ basics.name }} - Cover Letter</title>
<style>
  body { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 11pt; line-height: 1.5; color: #111; margin: 0; }
  .name { font-size: 16pt; font-weight: bold; }
  .contact { color: #333; font-size: 10pt; margin-bottom: 24px; }
  p { margin: 0 0 12px; }
</style>
</head>
<body>
  <div class="name">{{ basics.name }}</div>
  <div class="contact">{{ [basics.email, basics.phone, basics.location] | select | join(" | ") }}</div>
  <p>{{ today }}</p>
  <p>Hiring Team, {{ company }}</p>
  {% for para in paragraphs %}<p>{{ para }}</p>{% endfor %}
</body>
</html>
